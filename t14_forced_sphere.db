// =============================================================================
// STATIONARY SPHERE TEST - Bubble at rest in gas phase
// =============================================================================
// Fluid bubble immersed in gas phase with zero body force
// Single node job - Tests that bubble remains stationary without external force
//
// Flow setup:
//   - Zero body force (F = 0, 0, 0)
//   - Fluid bubble in gas phase
//   - Should remain stationary due to surface tension equilibrium
// =============================================================================

Test {
    test_dir = "/home/dpt/build/poiseuille/"
    unit_test = 1
}

Color {
    default_phase = -1
    biharmonic_solver = 0
    method = 10
    tauA = 1.0              // Relaxation time → ν = (τ-0.5)/3 = 0.1667
    tauB = 1.0
    rhoA = 5.9082346452     // Liquid density (bubble phase)
    rhoB = 0.5799723133     // Gas density (surrounding phase)
    // Zero body force - bubble should stay stationary
    F = 0, 0, 0
    Restart = false
    din = 5.9082346452      // Liquid density
    dout = 0.5799723133     // Gas density
    timestepMax = 1000001      // Run for 4k timesteps
    ComponentAffinity = 0.99
    
    // Solid boundary condition: 0=HWBB, 1=LIBB, 2=EI
    solid_bc = 1
    
    // Equation of state: "standard" or "cp"
    eos_type = "cp"
    
    Bubble = 1              // Enable bubble initialization (reads bubble.txt for geometry)
    notMultiBubble = 1
    // Peng-Robinson EOS parameters
    pr_a = 0.0408163265     // 2/49
    pr_b = 0.0952380952     // 2/21
    pr_omega = 0.344        // Acentric factor
    pr_kappa = 0.02        // Interface thickness
    use_mrt = 1             // MRT collision
}

Domain {
    AnalyticVolumeFraction = false
    nproc = 1,1,2           // Single node
    n = 45, 45, 45          // Domain size
    k_factor = 0.5         // k=1
    N = 70, 70, 70
    L = 1, 1, 1             // Physical dimensions
    BC = 0                  // Periodic BC
    ReservoirMin = 0
    ReservoirMax = 0
    usr = "dpt"
    filesystem = 0
    InitialSaturation = 1.0
    RandomSaturation = 1.0
    ReadValues = 0, 1, 2
    WriteValues = 0, 1, 2
    legacySDs = false
    Berea = false
    deltaR = 0.001
    WBCFlag = 0
    offsetDistance = 0
    Blender = 0
    InletLayers = 0, 0, 0
    OutletLayers = 0, 0, 0
    
    // ================================================================
    // SPHERE PACK GEOMETRY (from RayCast)
    // ================================================================
    GeometryType = "sphere_packing"
    
    nspheres = 0            // Will be set by RayCast pack.out
    
    // No parallel plates
    NumberOfPlateSets = 0
    
    // Flow direction (not really used with zero force)
    FlowDirection = 2
}

Chemicalpotential {
    // Kinematic viscosity: ν = (τ-0.5)/3 = 0.1667
    niu_1 = 0.1666666667
    niu_2 = 0.1666666667
    
    // Two-phase densities from Peng-Robinson EOS at T/Tc = 0.9
    rho_1 = 5.9082346452    // Liquid density (bubble)
    rho_2 = 0.5799723133    // Gas density (surrounding)
    
    wetting_param = 0.0     // Neutral wetting
    
    // Reduced temperature
    T_Tc = 0.9
    
    // Zero force - stationary test
    poiseuille_test = 1     // Disable Poiseuille output
    body_force_x = 0.0
    body_force_y = 0.0
    body_force_z = 0.0      // Zero force
    rho_inlet = 5.9082346452
    rho_outlet = 0.5799723133
    velocity_inlet = 0.0
    flow_direction = 2
    
    // Interface parameters - bubble centered in domain
    inlet_fluid_layers = 0
    outlet_fluid_layers = 0
    interface_z_position = 2   // Center of 40-cell domain
    interface_width = 5.0
    
    pr_a = 0.0408163265     // 2/49
    pr_b = 0.0952380952     // 2/21
    pr_omega = 0.344        // Acentric factor
    pr_kappa = 0.02        // Interface thickness
}

Analysis {
    analysis_padding = 2
    dt = 20
    Newton_iteration_error_tol = 0.001
    blobid_interval = 5000000
    analysis_interval = 200
    start_interval = 100000000
    restart_interval = 1000000
    visualization_interval = 100
    component_interval = 1000000
    restart_file = "Restart"
    N_threads = 8
    load_balance = "default"
    subdivide = 1, 1, 1
    CaThreshold = 1E-3
    analysis_method = 0
}

Visualization {
}
